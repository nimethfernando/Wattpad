# ==========================================
# AVORA LIBRARY - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local and populate with your production values.
# ==========================================

# Application Branding & URLs
NEXT_PUBLIC_APP_NAME="Avora Library"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Admin JWT Secret (minimum 32 characters, secure random string)
ADMIN_JWT_SECRET="your-secure-jwt-secret-at-least-32-chars-random"

# MariaDB / MySQL Database Connection
DB_HOST="your-cpanel-or-rds-host.com"
DB_PORT=3306
DB_USER="your_database_username"
DB_PASSWORD="your_secure_database_password"
DB_NAME="your_database_name"
DATABASE_URL="mariadb://your_database_username:your_secure_database_password@your-cpanel-or-rds-host.com:3306/your_database_name"

# SMTP / Email Notification Service (Gmail App Password or Custom SMTP)
EMAIL_USER="notifications@yourdomain.com"
EMAIL_PASS="your-16-character-app-password"
